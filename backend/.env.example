# --- Offline demo: run the whole app with NO key (returns a rich sample) ---
# A2UI_DEMO=1

# --- Default: Google Gemini via AI Studio (free tier) ---
# Create a key at https://aistudio.google.com/apikey  ->  "Create API key".
# It MUST start with "AIza..."  (an "AQ...." value is an OAuth token, not this).
A2UI_MODEL=gemini/gemini-3.6-flash
GEMINI_API_KEY=AIza_your_key_here

# --- Alternative free cloud: Groq (fast; needs GROQ_API_KEY) ---
# https://console.groq.com/keys
# A2UI_MODEL=groq/llama-3.1-8b-instant
# GROQ_API_KEY=your_groq_key_here

# --- Alternative free cloud: OpenRouter (:free models) ---
# A2UI_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=your_openrouter_key_here

# --- Local / offline (no key), if you run Ollama ---
# A2UI_MODEL=ollama/qwen2.5:3b
# A2UI_API_BASE=http://localhost:11434

# --- Vertex AI note ---
# If you'd rather use Vertex (project-based OAuth, like your AQ.* token), that's
# supported by LiteLLM via model "vertex_ai/gemini-2.0-flash" + vertex_project +
# application-default credentials. Not usable from the Claude sandbox (egress
# blocks aiplatform.googleapis.com), but fine on your own machine.
